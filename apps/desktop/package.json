{
  "name": "@helix/desktop",
  "productName": "Helix-X Docker Client",
  "version": "0.1.1",
  "description": "Cross-platform desktop client for browsing and moving images between any container registry and your local Docker engine.",
  "homepage": "https://example.com/helix-x-docker-client",
  "main": "./out/main/index.js",
  "author": "Helix-X",
  "license": "MIT",
  "private": true,
  "scripts": {
    "predev": "node scripts/patch-electron-dev.mjs",
    "dev": "electron-vite dev",
    "prestart": "node scripts/patch-electron-dev.mjs",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint src tests scripts electron.vite.config.ts",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder --mac --win --linux --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@helix/core": "workspace:*",
    "@helix/shared": "workspace:*",
    "@helix/tsconfig": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-log": "^5.4.4",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
